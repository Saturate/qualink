{
  "name": "qualink",
  "version": "0.6.0",
  "description": "Collect, normalize, and relay code quality metrics from CI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "qualink": "bin/qualink.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@11.0.6+sha512.97f906e1da2bedac3df83cadae04b4753a130092dd49d55cd36825ad3e623e9df3f97754f8f259e699172a360fac569acf2f908e7732bdae3eddb2dcf7e121fd",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./bin/qualink.js",
    "dev": "node --loader ts-node/esm src/cli/index.ts",
    "lint": "biome check src/",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build",
    "changelog": "git-cliff -o CHANGELOG.md"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "fast-xml-parser": "^5.7.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "git-cliff": "^2.13.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Saturate/qualink.git"
  },
  "homepage": "https://github.com/Saturate/qualink",
  "bugs": {
    "url": "https://github.com/Saturate/qualink/issues"
  },
  "keywords": [
    "ci",
    "code-quality",
    "elastic",
    "metrics"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
